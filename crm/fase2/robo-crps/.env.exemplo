# Copie para .env e preencha. O .env NÃO vai para o git.
#
# A service_role key entra em tudo no banco, sem passar por RLS. Ela existe
# só nesta máquina: nunca no navegador, nunca num print, nunca num commit.
# Está no Supabase em Settings → API → service_role (secret).

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=cole-a-service-role-aqui

# quanto o robô espera entre uma consulta e outra (ms). A sessão do gov.br
# dura poucos minutos, então corremos um pouco: 2,5s. Aumente se o INSS
# reclamar de volume; diminua se o crachá cair antes de terminar.
CRPS_PAUSA_MS=2500

# CRPS_REFORCAR=1 reconsulta TUDO, mesmo o que já foi hoje (padrão: retoma,
# pulando o que já consultou hoje — bom quando o crachá cai no meio).
# CRPS_REFORCAR=

# nome do procurador (você), para separar do cliente na lista de recorrentes
CRPS_PROCURADOR=PAULO ROBERTO TERCINI

# endereço do e-Recursos (raramente muda)
CRPS_URL=https://consultaprocessos.inss.gov.br
