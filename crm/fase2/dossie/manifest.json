{
  "manifest_version": 3,
  "name": "Dossiê do cliente — Tercini",
  "version": "0.4.2",
  "key": "",
  "description": "Na sessão gov.br já logada do cliente, baixa num clique os documentos do Meu INSS, do e-Recursos, do Emprega Brasil (CTPS, RAIS, CAGED) e do HC Ribeirão (exames de imagem, internações, relatórios) para a pasta do cliente em G:\\Meu Drive\\Processos e para a ficha no CRM.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://meu.inss.gov.br/*",
    "https://vip-pmeuinss-api.inss.gov.br/*",
    "https://vip-pmeuinss-arq.inss.gov.br/*",
    "https://consultaprocessos.inss.gov.br/*",
    "https://servicos.mte.gov.br/*",
    "https://mte.api.dataprev.gov.br/*",
    "https://appiris.hcrp.usp.br/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "fundo.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dossiê do cliente"
  },
  "options_page": "config.html"
}
